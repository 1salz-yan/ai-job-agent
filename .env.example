# AI Job Agent — environment variables
# (imported into the local SQLite DB on first start;
#  you can also enter everything in the dashboard UI under "Einstellungen")

# --- Required for AI features ---
# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# --- Optional: job search ---
# Adzuna DE (free: https://developer.adzuna.com) — App ID + App Key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Bundesagentur für Arbeit Jobbörse (BA developer portal)
BA_API_KEY=

# --- Optional: email monitoring ---
# QQ Mail example: host imap.qq.com, port 993.
# Use the account-specific "授权码" (auth code), NOT your login password.
EMAIL_IMAP_HOST=imap.qq.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- Optional: initial profile seed (only used when the profile table is empty) ---
APPLICANT_NAME=Max Mustermann
APPLICANT_CONTACT=Musterstraße 1, 10115 Berlin  |  max@example.com  |  +49 170 0000000
