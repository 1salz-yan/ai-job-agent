# AI Job Agent — environment variables
# (imported into the local SQLite DB on first start;
#  you can also enter everything in the dashboard UI under "Einstellungen")

# --- Required for AI features ---
# Any OpenAI-compatible chat API. Default provider: DeepSeek
# (create key at https://platform.deepseek.com)
LLM_API_KEY=
# Optional: base URL for a different OpenAI-compatible provider
# (e.g. https://api.openai.com/v1 — leave empty for DeepSeek default)
LLM_API_BASE=

# Optional: export folder for generated documents
# (leave empty for ~/Desktop/Application)
EXPORT_DIR=

# --- Optional: job search ---
# Adzuna DE (free: https://developer.adzuna.com) — App ID + App Key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Bundesagentur für Arbeit Jobbörse (BA developer portal)
BA_API_KEY=

# --- Optional: email monitoring (any IMAP mailbox) ---
# Examples:
#   QQ Mail:       imap.qq.com:993          (use the account 授权码 / auth code)
#   GMail:         imap.gmail.com:993       (App Password)
#   Outlook:       outlook.office365.com:993
# Use an app-specific password / auth code, NOT your login password.
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- Optional: initial profile seed (only used when the profile table is empty) ---
APPLICANT_NAME=Max Mustermann
APPLICANT_CONTACT=Musterstraße 1, 10115 Berlin  |  max@example.com  |  +49 170 0000000
